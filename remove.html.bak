<!DOCTYPE html>
<html lang="en">
    
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
	<style>
	*{
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}
body{
    background-color: rgb(66, 100, 122);
}
.title{
    text-align: center;
    
}
.continer{
    margin: 15px;
    margin-top: 10px;
    padding: 15px;
    background-color: azure;
    border-radius: 10px;
    display: flex;
    height: 88vh;
    display: flex;
}
.form_section{
    
    width: 35%;

}
.Add_budget{
    padding: 0 4%;
    border:3px solid gray;
    background-color: white;
    border-radius: 10px;
    border:2px rgb(227, 227, 227) solid;
    
}
.tit{
    font-size: 3vw;
    font-size: clamp(15px, 3vw, 30px);
    margin: 3% 0;
}

input{
    width:100%;
    padding: 0.8vw;
    font-size: 1rem;
    outline: none;
    border: 1px gray solid;
    border-radius: 12px ;
    margin-top: 2%;
}
.submit{
    color:white;
    width: 100%;
    padding: 0.8vw 0;
    border: none;
    margin:  3% 0;
    background: rgb(38, 64, 183);
    cursor: pointer;
    font-size: 1rem;
    border-radius: 12px ;
}
.resat{
    color:white;
    width: 100%;
    padding: 0.4rem 0;
    border: none;
    margin-top:  3%;
    background: rgb(255, 40, 40);
    cursor: pointer;
    font-size: 1rem;
    border-radius: 12px ;
}
.Add_expenses{
    padding: 0 4%;
    margin-top: 10px;
    border:4px solid green;
    background-color: white;
    border-radius: 10px;
    border:2px rgb(227, 227, 227) solid;
    
}
.update_expenses{
    position: fixed;
    top: 25%;
    left: 25%;
    width: 50%;
    height: auto;
    padding: 3%;
    background-color: white;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    display: none;
}
.update_expenses form{
    margin-top: 5%;
    display: flex;
    flex-direction: column;
}
.listContenir{
    border:2px rgb(227, 227, 227) solid;
    border-radius: 10px;
    width: 77%;
    margin-left: 2%;
    background-color: white ;
    height: 100%;
    padding: 0 1%;
    display: flex;
    flex-direction: column;
}
.total{
    font-weight: 550;
    background-color: aqua;
    border-radius: 5px;
    margin: 0.5%;
    padding: 0.6vw;
    text-align: center;
}
.updetOrList{
    display: flex;
    align-items: center ;
}
.list{
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1% 1%;
    padding-right: 3%;
    border-bottom: 1px rgb(114, 114, 114) solid;
    font-size: clamp(12px, 2vw, 20px);
    width: 95%;
    position: relative;
    overflow: hidden;
    gap: 10px;
}
.list-tit{
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1% 1%;
    padding-right: 3%;
    border-bottom: 1px rgb(114, 114, 114) solid;
    font-size: clamp(12px, 2vw, 20px);
    font-weight: 900;
    width: 95%;
    position: relative;
    overflow: hidden;
    gap: 10px;
    margin-bottom: 4%;
}
.list-tit p:not(:first-child){
    
    position: relative;
    left: -6vw;
}
.list p{
    transition: transform 1s ease;
    white-space: nowrap;
}
.remove_button{
    border: none;
    background-color: transparent;
    padding: 0px;
    
    position: absolute;
    right: 5vw;
    opacity: 0;
    transform: translateX(10vw);
    transition: all 1s ease;
}

.Id{
    display: none;
}
.spanimg{
    height: 2.6vw;
    width: 2.6vw;
    min-width: 15px;
    min-height: 15px;
}
.updet{
    margin-left: 0.6%;
    height: 2.6vw;
    width: 2.6vw;
    min-width: 15px;
    min-height: 15px;
}
.list:hover .remove_button{
    opacity: 1;
    transform: translateX(4vw);
}
.list:hover p:not(:first-child){
    transform: translateX(-5vw);
}
.hed{
    padding: 15px;
    display: flex;
    align-items: center;
    justify-content: space-around;
}

.expanse_list{
    
    
    height: 55vh;
    overflow-y: auto;
    margin-top: -2%;
    padding-bottom: -15%;
}
@media (max-width:420px){
    .continer{
        display: block;
        height: auto;
        padding: 2%;
        margin: 2%;
    }
    .form_section{
        width: 100%;
    }
    .listContenir{
        width: 100%;
    }
    .total{
        font-size: 4vw;
        padding: 0%;
    }
    .hed{
        padding: 1%;
        order:3;
    }
    .expanse_list{
        order: 1;
    }
    .resat{
        order: ;
    }
}

	</style>
</head>
<body>
    <h1 class="title">Expense Tracker System</h1>
    <div class="continer">
        
        <div class="form_section">
            <div class="Add_budget">
                <h1 class="tit">Add Budget</h1>
                <form>
                    <label>Budget:</label>
                    <input class="budget_inpot" type="number">
                    <button class="add_badget submit" type="submit">Add badget</button>
                </form>
            </div>
            <div class="Add_expenses">
                <h1 class="tit">Add Expense</h1>
                <form>
                    <label>Expense Title:</label>
                    <input class="expenseTitle" type="text">
                    <label>Amount:</label>
                    <input class="amount" type="number">
                    <button class="add_expense submit" type="submit">Add expense</button>
                </form>
            </div>
            <button class="resat">Resat All</button>
        </div>
        <div class="listContenir">
            <div class="hed">
                <div class="budget total">Total Budgert: 0.0$</div>
                <div class="Expenses total">Total Expenses: 0.0$</div>
                <div class="left total">Budget Left: 0.0$</div>
            </div>
            <hr>
            <h1 class="tit">Expense History:</h1>
            <div class="list-tit"><p>Expense Name</p> <p>Amount</p><p>Data</p></div>
            <div class="expanse_list">
                <!--<div class="updetOrList"><img class="updet" src="./image/available_updates_80px.png"><div class="list"><p>test_Books</p> <p>1500</p><p>2026/2/15</p><img class="spanimg remove_button" src="./image/delete_64px.png"></div><span class="Id">2242312</span></div>
                <div class="list"><p>test_Books</p> <p>1500</p><img class="spanimg remove_button" src="./image/delete_64px.png"></div>
                <div class="list"><p>test_Books</p> <p>1500</p><img class="spanimg remove_button" src="./image/delete_64px.png"></div>
            -->
            </div>
        </div>
    </div>

    <div class="update_expenses">
                <h1 class="tit">Update Expense</h1>
                <form>
                    <label>Expense Title:</label>
                    <input class="UpexpenseTitle" type="text">
                    <label>Amount:</label>
                    <input class="Upamount" type="number">
                    <button class="update_expense submit" type="submit">Update</button>
                </form>
        </div>

    <script src="index.js"></script>
</body>
</html>